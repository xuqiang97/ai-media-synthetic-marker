# Python bytecode and tool caches
__pycache__/
*.py[codz]
*$py.class
.cache/
.hypothesis/
.mypy_cache/
.nox/
.pyre/
.pytest_cache/
.pytype/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Python environments and local packaging state
.venv/
venv/
env/
ENV/
__pypackages__/
.eggs/
*.egg-info/

# Build and release output
/build/
/dist/
*.manifest
*.spec
*.toc
*.log

# Local ExifTool runtime (the lock file and README remain tracked)
/runtime/exiftool/*
!/runtime/exiftool/README.md

# Local developer media and CSV records
/dev/待标记/*
!/dev/待标记/.gitkeep
/dev/运行记录/*
!/dev/运行记录/.gitkeep

# Private and legacy workspace paths (keep blocked even when absent)
/image/
/video/
/exiftool/
/快速教学版/
/便携EXE版/
/AI人物媒体标记工具-便携EXE版.zip
/.exiftool-download-check.txt

# ExifTool backups and local-only fixtures
*_original
/local-fixtures/
/tests/local-fixtures/

# Privacy guard: media and runtime records are opt-in, never committed by accident
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[mM][pP]4
*.[cC][sS][vV]
!docs/assets/**/*.[pP][nN][gG]

# Local configuration
.env
.env.*
!.env.example

# Editors and operating-system files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
